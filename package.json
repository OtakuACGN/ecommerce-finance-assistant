{
  "name": "diancaitong",
  "version": "1.3.0",
  "type": "module",
  "description": "店财通 - 电商经营财务助手（拼多多经营分析 / 毛利 / 对账）",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build && set ELECTRON_BUILDER_COMPRESSION_LEVEL=5&& electron-builder --win nsis",
    "build:dir": "vite build && electron-builder --win dir",
    "preview": "vite preview",
    "pack": "npm run build",
    "smoke": "tsx scripts/smoke-suite.mts",
    "stress": "tsx scripts/stress-suite.mts",
    "test:ui": "vitest run",
    "validate:workbook": "tsx scripts/validate-workbook.mts",
    "validate": "tsc --noEmit && npm run smoke && npm run test:ui"
  },
  "keywords": [
    "electron",
    "react",
    "ecommerce",
    "pinduoduo",
    "finance",
    "profit"
  ],
  "author": "Local",
  "license": "MIT",
  "dependencies": {
    "lucide-react": "^0.294.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^6.0.4",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.23",
    "tailwindcss": "^3.3.6",
    "tsx": "^4.23.1",
    "typescript": "^5.3.3",
    "vite": "^8.1.5",
    "vite-plugin-electron": "^1.1.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "brace-expansion": "5.0.8"
  },
  "build": {
    "appId": "com.diancaitong.app",
    "productName": "店财通",
    "copyright": "Copyright 2026",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "extraMetadata": {
      "main": "dist-electron/main.cjs"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "DianCaiTong-Setup-${version}.exe",
      "signAndEditExecutable": true,
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "店财通",
      "installerLanguages": [
        "zh_CN"
      ],
      "language": "2052",
      "differentialPackage": false,
      "artifactName": "DianCaiTong-Setup-${version}.exe"
    },
    "asar": true
  },
  "productName": "店财通"
}
